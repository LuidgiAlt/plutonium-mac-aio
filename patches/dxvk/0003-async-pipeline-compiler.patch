index 4c5ea32..5c82101 100644
--- a/src/dxvk/dxvk_pipemanager.cpp
+++ b/src/dxvk/dxvk_pipemanager.cpp
@@ -13,6 +13,70 @@ namespace dxvk {
     
     if (useStateCache != "0" && device->config().enableStateCache)
       m_stateCache = new DxvkStateCache(device, this, passManager);
+
+    if (env::getEnvVar("DXVK_ASYNC") == "1") {
+      m_async = true;
+      m_asyncCompiler = std::make_unique<DxvkAsyncCompiler>(2);
+      Logger::info("DXVK: Async pipeline compiler enabled");
+    }

+
+
+  DxvkAsyncCompiler::DxvkAsyncCompiler(uint32_t numThreads) {
+    for (uint32_t i = 0; i < numThreads; i++) {
+      m_threads.emplace_back([this] () { run(); });
+      m_threads.back().set_priority(ThreadPriority::Lowest);
+    }
+  }
+
+
+  DxvkAsyncCompiler::~DxvkAsyncCompiler() {
+    this->stop();
+  }
+
+
+  void DxvkAsyncCompiler::stop() {
+    { std::lock_guard<dxvk::mutex> lock(m_mutex);
+      if (m_stop)
+        return;
+      m_stop = true;
+      m_cond.notify_all();
+    }
+
+    for (auto& t : m_threads)
+      t.join();
+    m_threads.clear();
+  }
+
+
+  void DxvkAsyncCompiler::queue(
+          DxvkGraphicsPipeline*         pipeline,
+    const DxvkGraphicsPipelineStateInfo& state,
+    const DxvkRenderPass*               renderPass) {
+    std::lock_guard<dxvk::mutex> lock(m_mutex);
+    m_queue.push({ pipeline, state, renderPass });
+    m_cond.notify_one();
+  }
+
+
+  void DxvkAsyncCompiler::run() {
+    env::setThreadName("dxvk-async");
+
+    while (true) {
+      Job job;
+
+      { std::unique_lock<dxvk::mutex> lock(m_mutex);
+        m_cond.wait(lock, [this] { return m_stop || !m_queue.empty(); });
+
+        if (m_stop)
+          return;
+
+        job = m_queue.front();
+        m_queue.pop();
+      }
+
+      job.pipeline->compileQueued(job.state, job.renderPass);
+    }
   }
   
   
@@ -80,7 +144,29 @@ namespace dxvk {
   }
 
 
+  uint32_t DxvkPipelineManager::takeAsyncWaitBudget(uint32_t wantMs) {
+    constexpr uint32_t BudgetMs = 3;
+    constexpr uint64_t WindowMs = 16;
+    uint64_t nowMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+      dxvk::high_resolution_clock::now().time_since_epoch()).count();
+
+    std::lock_guard<dxvk::mutex> lock(m_asyncWaitMutex);
+
+    if (nowMs - m_asyncWaitWindowMs >= WindowMs) {
+      m_asyncWaitWindowMs = nowMs;
+      m_asyncWaitSpentMs = 0;
+    }
+
+    uint32_t grant = std::min(wantMs, BudgetMs - std::min(m_asyncWaitSpentMs, BudgetMs));
+    m_asyncWaitSpentMs += grant;
+    return grant;
+  }
+
+
   void DxvkPipelineManager::stopWorkerThreads() const {
+    if (m_asyncCompiler)
+      m_asyncCompiler->stop();
+
     if (m_stateCache != nullptr)
       m_stateCache->stopWorkerThreads();
   }

@@ -86,6 +118,60 @@ namespace dxvk {
   }
 
 
+  void DxvkGraphicsPipeline::compileQueued(
+    const DxvkGraphicsPipelineStateInfo& state,
+    const DxvkRenderPass*                renderPass) {
+    // Compile without holding m_mutex, then publish the result.
+    VkPipeline pipeline = VK_NULL_HANDLE;
+
+    if (!this->findInstance(state, renderPass)) {
+      pipeline = this->createPipeline(state, renderPass);
+
+      // DXVK_ASYNC_FAIL_TEST=1 (tests only): every background compile fails.
+      static const bool failTest = env::getEnvVar("DXVK_ASYNC_FAIL_TEST") == "1";
+
+      if (failTest && pipeline) {
+        this->destroyPipeline(pipeline);
+        pipeline = VK_NULL_HANDLE;
+      }
+
+      if (!pipeline)
+        Logger::err("DxvkGraphicsPipeline: async compile failed");
+    }
+
+    { std::lock_guard<dxvk::mutex> lock(m_mutex);
+
+      if (!this->findInstance(state, renderPass)) {
+        // A failed compile is stored as well (null handle), as the
+        // synchronous path does, so that draws with this state are skipped
+        // instead of queueing the same compile again every frame.
+        m_pipelines.emplace(state, renderPass, pipeline);
+
+        if (pipeline) {
+          m_pipeMgr->m_numGraphicsPipelines += 1;
+          this->writePipelineStateToCache(state, renderPass->format());
+        }
+
+        pipeline = VK_NULL_HANDLE;
+      }
+    }
+
+    if (pipeline)
+      this->destroyPipeline(pipeline);
+
+    std::lock_guard<dxvk::mutex> lock(m_queueMutex);
+
+    for (auto q = m_queued.begin(); q != m_queued.end(); q++) {
+      if (q->isCompatible(state, renderPass)) {
+        m_queued.erase(q);
+        break;
+      }
+    }
+
+    m_queueCond.notify_all();
+  }
+

+/* Experimental, opt-in instruction stepping; never modifies executable bytes. */
+static BOOL rosetta_exec_breakpoints( struct amd64_thread_data *data )
+{
+#ifdef __APPLE__
+    unsigned int i;
+    if (!is_rosetta2 || !emulate_rosetta_exec_breakpoints) return FALSE;
+    if (is_wow64() && !emulate_rosetta_wow64_breakpoints) return FALSE;
+    for (i = 0; i < 4; i++)
+        if (((data->dr7 >> (2 * i)) & 3) && !((data->dr7 >> (16 + 4 * i)) & 15))
+            return TRUE;
+#endif
+    return FALSE;
+}
+
+
+struct xcontext;
+static void setup_raise_exception( ucontext_t *sigcontext, EXCEPTION_RECORD *rec, struct xcontext *xcontext );
+
+static unsigned int rosetta_breakpoint_hits( struct amd64_thread_data *debug, ULONG_PTR pc, DWORD flags )
+{
+    ULONG_PTR addresses[4] = { debug->dr0, debug->dr1, debug->dr2, debug->dr3 };
+    unsigned int i, hits = 0;
+
+    if (flags & 0x10000) return 0;
+    for (i = 0; i < 4; i++)
+        if (((debug->dr7 >> (2 * i)) & 3) && !((debug->dr7 >> (16 + 4 * i)) & 15)
+            && addresses[i] == pc) hits |= 1 << i;
+    return hits;
+}
+
+static NTSTATUS rosetta_initial_breakpoint(void);
+
+/* NtSetContextThread on the current thread from a signal handler or a user
+ * dispatcher: without the resume-address breakpoint check, which would raise
+ * an exception in the middle of the interrupted call or dispatch. */
+static NTSTATUS set_own_context_no_resume_check( const CONTEXT *context )
+{
+#ifdef __APPLE__
+    struct amd64_thread_data *data = amd64_thread_data();
+    BYTE saved = data->dispatching_breakpoint;
+    NTSTATUS status;
+
+    data->dispatching_breakpoint = TRUE;
+    status = NtSetContextThread( GetCurrentThread(), context );
+    data->dispatching_breakpoint = saved;
+    return status;
+#else
+    return NtSetContextThread( GetCurrentThread(), context );
+#endif
+}

+/* A TF trap occurs after an instruction. Check the resume PC separately so
+ * a breakpoint at the first instruction is not skipped. */
+static NTSTATUS rosetta_initial_breakpoint(void)
+{
+#ifdef __APPLE__
+    struct amd64_thread_data *debug = amd64_thread_data();
+    struct syscall_frame *frame = get_syscall_frame();
+    ULONG_PTR addresses[4];
+    unsigned int i, hits = 0;
+    CONTEXT context;
+    EXCEPTION_RECORD rec = { .ExceptionCode = EXCEPTION_SINGLE_STEP };
+    NTSTATUS status;
+
+    if (is_wow64() || !debug || debug->dispatching_breakpoint ||
+        !rosetta_exec_breakpoints( debug ) || (frame->eflags & 0x10000)) return STATUS_SUCCESS;
+    addresses[0] = debug->dr0;
+    addresses[1] = debug->dr1;
+    addresses[2] = debug->dr2;
+    addresses[3] = debug->dr3;
+    for (i = 0; i < 4; i++)
+        if (((debug->dr7 >> (2 * i)) & 3) && !((debug->dr7 >> (16 + 4 * i)) & 15)
+            && addresses[i] == frame->rip) hits |= 1 << i;
+    if (!hits) return STATUS_SUCCESS;
+
+    context.ContextFlags = CONTEXT_ALL;
+    if ((status = NtGetContextThread( GetCurrentThread(), &context ))) return status;
+    context.Dr6 = debug->dr6 = (debug->dr6 & ~0x400f) | hits;
+    context.EFlags |= 0x10000;
+    rec.ExceptionAddress = (void *)context.Rip;
+    {
+        CONTEXT regs = context;
+        BOOL self;
+        regs.ContextFlags = CONTEXT_DEBUG_REGISTERS;
+        if ((status = set_thread_context( GetCurrentThread(), &regs, &self, IMAGE_FILE_MACHINE_AMD64 ))) return status;
+    }
+    debug->dispatching_breakpoint = TRUE;
+    status = NtRaiseException( &rec, &context, TRUE );
+    debug->dispatching_breakpoint = FALSE;
+    return status;
+#else
+    return STATUS_SUCCESS;
+#endif
+}
+
+
+#ifdef __APPLE__
+/* Arms or disarms the emulated single-step of the current WOW64 thread from
+ * its debug registers once a 32-bit context has been applied: set by the
+ * thread itself, or by another thread while it was blocked in a syscall
+ * (the context then arrives through wait_suspend). eflags is the
+ * application's EFLAGS for that context, or NULL if they did not change. */
+static void rosetta_update_wow64_step( I386_CONTEXT *wow_frame, struct syscall_frame *frame, const DWORD *eflags )
+{
+    struct amd64_thread_data *amd64_data = amd64_thread_data();
+    WOW64_CPURESERVED *cpu = NtCurrentTeb()->TlsSlots[WOW64_TLS_CPURESERVED];
+    BOOL armed = rosetta_exec_breakpoints( amd64_data );
+
+    if (eflags)
+    {
+        amd64_data->application_step = !!(*eflags & 0x100);
+        amd64_data->resume_rf = !!(*eflags & 0x10000);
+        amd64_data->rf_rip = wow_frame->Eip;
+        amd64_data->rf_cs = cs32_sel;
+    }
+    /* Arming starts afresh: a stop left over from an earlier disarm must not
+     * swallow the first trap of the new breakpoints. */
+    amd64_data->stopping_step = amd64_data->emulated_step && !armed && !amd64_data->application_step;
+    if (!amd64_data->emulated_step && armed)
+        rosetta_event( "arm-set32", amd64_data, wow_frame->Eip, cs32_sel );
+    amd64_data->emulated_step = armed;
+    if (armed)
+    {
+        amd64_data->steps64 = 0;
+        amd64_data->after_pushf = FALSE;
+    }
+    if (armed) wow_frame->EFlags |= 0x100;
+    else if (!amd64_data->application_step) wow_frame->EFlags &= ~0x100;
+    if (amd64_data->stopping_step)
+    {
+        frame->eflags &= ~0x100;
+        frame->restore_flags |= CONTEXT_CONTROL;
+    }
+    if (armed || amd64_data->stopping_step)
+    {
+        amd64_data->step_rip = wow_frame->Eip;
+        amd64_data->step_rsp = wow_frame->Esp;
+        amd64_data->step_cs = cs32_sel;
+        /* The fast WOW64 syscall entry does not refresh segment fields. */
+        wow_frame->SegSs = ds64_sel;
+        wow_frame->SegFs = amd64_data->fs;
+        if (cpu) cpu->Flags |= WOW64_CPURESERVED_FLAG_RESET_STATE;
+    }
+}
+#endif
+

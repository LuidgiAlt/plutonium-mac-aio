+        amd64_data->rf_cs = context->SegCs;
+        if (!amd64_data->emulated_step && rosetta_exec_breakpoints( amd64_data ))
+            rosetta_event( "arm-restore", amd64_data, context->Rip, context->SegCs );
+        amd64_data->emulated_step = rosetta_exec_breakpoints( amd64_data );
+        if (amd64_data->emulated_step)
+        {
+            amd64_data->stopping_step = FALSE;
+            amd64_data->steps64 = 0;
+            amd64_data->after_pushf = FALSE;
